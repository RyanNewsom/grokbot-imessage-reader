<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.imessage-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_HOME/Library/Application Support/imessage-helper/imsg-helper.app/Contents/MacOS/imsg-helper</string>
    <string>--serve</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
